# ============================================================
# Portfolio API — Environment Variables
# Copy to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/portfolio
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string
JWT_EXPIRES_IN=7d

# Admin account (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=MinimumEightChars!

# Nodemailer — Gmail SMTP
# App Password: Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_TO=your_gmail@gmail.com

# AI Provider
# Providers: gemini | claude
# Get your Gemini key at https://aistudio.google.com/app/apikey
# Click "Create API key" → "Create API key in new project"
# Both key formats work: AIzaSy... and AQ.Ab8...
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash

# CORS — set to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173
